{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitekit.local/schemas/visual-evidence-v1.schema.json",
  "title": "SiteKit visual evidence v1",
  "description": "Observed browser evidence for Main SiteKit. It is not OpenSite and contains no renderer-owned numeric variant authority.",
  "type": "object",
  "required": ["format", "version", "source", "viewports", "sections", "themeEvidence"],
  "properties": {
    "format": {"const": "sitekit-visual-evidence"},
    "version": {"const": "1.0"},
    "source": {
      "type": "object",
      "required": ["url", "capturedAt", "sourceType", "artifacts"],
      "properties": {
        "url": {"type": "string"},
        "finalUrl": {"type": "string"},
        "capturedAt": {"type": "string"},
        "sourceType": {"type": "string"},
        "artifacts": {"type": "object"}
      },
      "additionalProperties": false
    },
    "viewports": {
      "type": "object",
      "required": ["desktop", "mobile"],
      "properties": {
        "desktop": {"$ref": "#/$defs/viewport"},
        "mobile": {"$ref": "#/$defs/viewport"}
      },
      "additionalProperties": false
    },
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "documentSurfaces": {"type": "object"},
    "themeEvidence": {"type": "object"},
    "semanticAuthority": {"const": "main-sitekit"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["width", "height", "pageWidth", "pageHeight", "screenshot", "sections"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "pageWidth": {"type": "integer", "minimum": 0},
        "pageHeight": {"type": "integer", "minimum": 0},
        "screenshot": {"type": "string"},
        "html": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/viewportSection"}}
      },
      "additionalProperties": false
    },
    "viewportSection": {
      "type": "object",
      "required": ["evidenceId", "order", "bbox", "visibility"],
      "properties": {
        "evidenceId": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "visibility": {"type": "object"}
      },
      "additionalProperties": true
    },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["evidenceId", "order", "locator", "bboxes", "visibility", "text", "actions", "media", "forms", "repeatedItems", "background", "computedVisual", "visual", "roleCandidates", "patternCandidates", "confidence", "evidence"],
      "properties": {
        "evidenceId": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "locator": {"type": "object"},
        "bboxes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/bbox"}},
        "visibility": {"type": "object"},
        "text": {"type": "object"},
        "actions": {"type": "array", "items": {"type": "object"}},
        "media": {"type": "array", "items": {"type": "object"}},
        "forms": {"type": "object"},
        "repeatedItems": {"type": "object"},
        "navItems": {"type": "array", "items": {"type": "object"}},
        "background": {"type": "object"},
        "dominantSurfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}},
        "underlyingSurface": {"anyOf": [{"$ref": "#/$defs/surface"}, {"type": "null"}]},
        "accentColors": {"type": "array", "items": {"$ref": "#/$defs/accent"}},
        "dominantSurfacesByViewport": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/surface"}}},
        "underlyingSurfaceByViewport": {"type": "object", "additionalProperties": {"anyOf": [{"$ref": "#/$defs/surface"}, {"type": "null"}]}},
        "accentColorsByViewport": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/accent"}}},
        "computedVisual": {"type": "object"},
        "visual": {"type": "object"},
        "cropStatus": {"type": "string", "enum": ["written", "skipped", "not-captured"]},
        "cropReason": {"type": "string"},
        "cropRect": {
          "type": ["array", "null"],
          "items": {"type": "integer"},
          "minItems": 4,
          "maxItems": 4
        },
        "roleCandidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "patternCandidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["label", "confidence", "evidence"],
      "properties": {
        "label": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["color", "sourceKind", "bbox", "coverage"],
      "properties": {
        "color": {"type": "string"},
        "sourceKind": {"type": "string"},
        "coverage": {"type": "number", "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "backgroundImage": {"type": "string"},
        "gradientStops": {"type": "array", "items": {"type": "string"}},
        "locator": {"type": "object"}
      },
      "additionalProperties": false
    },
    "accent": {
      "type": "object",
      "required": ["color", "sourceKind", "usageCount"],
      "properties": {
        "color": {"type": "string"},
        "sourceKind": {"type": "string"},
        "usageCount": {"type": "integer", "minimum": 1},
        "bboxes": {"type": "array", "items": {"$ref": "#/$defs/bbox"}},
        "locators": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}
